{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mupx-docs",
  "compatibility_date": "2026-10-01",
  // No `main`: the Worker only serves the static export `pnpm build` writes.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "mupx.simoneergotino.it",
      "custom_domain": true,
    },
  ],
}
